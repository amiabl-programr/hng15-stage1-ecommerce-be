NODE_ENV=development
PORT=4000

# Web origin — CORS allowlist and email links
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Two different doors into the same project. Both are needed.
#
# SUPABASE_URL — the project HTTPS API gateway. @supabase/supabase-js talks JSON to
#   it at /rest/v1 (PostgREST), /auth/v1 (GoTrue) and /storage/v1, authenticated by
#   the keys below, with RLS enforced. Dashboard → Project Settings → Data API →
#   Project URL. Derived automatically when SUPABASE_DB_URL is a direct db.<ref>
#   host, but a pooler host does not reveal it, so set this explicitly.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres — SQL, migrations, integration tests. Authenticated by the DB
# password, NOT by the keys above, and the `postgres` role bypasses RLS.
#
# Port 5432 for the pooler is session mode; 6543 is transaction mode. Prefer the
# pooler when a direct db.<ref>.supabase.co host does not resolve. Percent-encode
# the password: `$` must be written %24.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=your-db-password

# Storage
STORAGE_BUCKET=products

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/google

SESSION_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAILS="owner@roofingco.com"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM="Roofing Construction Shop <you@gmail.com>"

BUSINESS_EMAIL=support@roofingco.com
BUSINESS_PHONE=+2348007663464

# Integration tests. Same database as SUPABASE_DB_URL — tests mutate it, so they
# create and drop their own fixtures. Never set in production.
TEST_SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional failover backup email provider (attempts delivery if SMTP fails 3+ times)
MAILER_SEND_KEY=
MAILER_SEND_FROM="Roofing Construction Shop <info@test-pzkmgq7e65yl059v.mlsender.net>"