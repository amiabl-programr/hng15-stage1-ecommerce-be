      },
      "UpsertProduct": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "profileKind": {
            "$ref": "#/components/schemas/ProfileKind"
          },
          "productType": {
            "$ref": "#/components/schemas/ProductType"
          },
          "unitType": {
            "$ref": "#/components/schemas/UnitType"
          },
          "basePrice": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minOrderQuantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "categoryId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "isActive": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "slug",
          "profileKind",
          "productType",
          "unitType",
          "basePrice",
          "minOrderQuantity",
          "isActive"
        ],
        "additionalProperties": false
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "customer",
          "admin"
        ]
      }
    }
  }
}
