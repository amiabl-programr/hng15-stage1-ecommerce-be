NODE_ENV=development
PORT=4000

# Web origin — CORS allowlist and email links
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (port 5432, NOT the pooler) — schema loop only.
# Supabase dashboard → Project Settings → Database. Same value as
# TEST_SUPABASE_DB_URL below; kept separate so a production deploy never needs it.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Storage
STORAGE_BUCKET=products

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/google

SESSION_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAILS="owner@roofingco.com"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM="Roofing Construction Shop <you@gmail.com>"

BUSINESS_EMAIL=support@roofingco.com
BUSINESS_PHONE=+2348007663464

# Integration tests. Same database as SUPABASE_DB_URL — tests mutate it, so they
# create and drop their own fixtures. Never set in production.
TEST_SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres